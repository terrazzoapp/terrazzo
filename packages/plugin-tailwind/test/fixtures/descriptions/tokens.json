{
  "color": {
    "$type": "color",
    "primary": {
      "$value": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8], "alpha": 1 },
      "$description": "Primary brand color",
      "$extensions": {
        "mode": {
          "light": { "colorSpace": "srgb", "components": [0.2, 0.4, 0.8], "alpha": 1 },
          "dark": { "colorSpace": "srgb", "components": [0.3, 0.5, 0.9], "alpha": 1 }
        }
      }
    },
    "secondary": {
      "$value": { "colorSpace": "srgb", "components": [0.1, 0.3, 0.7], "alpha": 1 },
      "$description": "Secondary brand color.\nUse for supporting UI, never for CTAs."
    },
    "danger": {
      "$value": { "colorSpace": "srgb", "components": [0.8, 0.1, 0.1], "alpha": 1 },
      "$description": "Destructive actions only /* not for warnings */"
    },
    "undocumented": {
      "$value": { "colorSpace": "srgb", "components": [0.5, 0.5, 0.5], "alpha": 1 }
    },
    "primary-alias": {
      "$value": "{color.primary}",
      "$description": "Alias with its own description"
    }
  },
  "space": {
    "$type": "dimension",
    "sm": {
      "$value": { "value": 4, "unit": "px" },
      "$description": "Tightest spacing step",
      "$extensions": {
        "mode": {
          "light": { "value": 4, "unit": "px" },
          "dark": { "value": 4, "unit": "px" }
        }
      }
    }
  }
}
