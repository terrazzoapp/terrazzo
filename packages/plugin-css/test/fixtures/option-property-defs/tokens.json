{
  "color": {
    "blue": {
      "$type": "color",
      "$value": "#0000ff"
    },
    "alias": {
      "$type": "color",
      "$value": "{color.blue}"
    },
    "alias-2": {
      "$type": "color",
      "$value": "{color.alias}"
    }
  },
  "space": {
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    }
  },
  "type": {
    "size": {
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "rem"
        },
        "$extensions": {
          "mode": {
            "desktop": {
              "value": 3,
              "unit": "rem"
            }
          }
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "sans-serif"
        ],
        "fontSize": "{type.size.lg}",
        "fontWeight": 700,
        "lineHeight": 1.2
      }
    }
  },
  "shadow": {
    "focus": {
      "$type": "shadow",
      "$value": {
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 0,
          "unit": "px"
        },
        "spread": {
          "value": 2,
          "unit": "px"
        },
        "color": "{color.blue}"
      }
    }
  }
}
