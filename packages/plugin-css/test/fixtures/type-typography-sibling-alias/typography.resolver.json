{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    }
  ],
  "sets": {
    "base": {
      "sources": [
        {
          "typography": {
            "family": {
              "sans": {
                "$type": "fontFamily",
                "$value": [
                  "Inter",
                  "system-ui",
                  "sans-serif"
                ]
              }
            },
            "size": {
              "lg": {
                "$type": "dimension",
                "$value": {
                  "value": 32,
                  "unit": "px"
                }
              }
            },
            "heading": {
              "$root": {
                "$type": "typography",
                "$value": {
                  "fontFamily": "{typography.heading.fontFamily}",
                  "fontSize": "{typography.heading.fontSize}",
                  "fontWeight": "{typography.heading.fontWeight}",
                  "lineHeight": "{typography.heading.lineHeight}",
                  "letterSpacing": "{typography.heading.letterSpacing}"
                }
              },
              "fontFamily": {
                "$type": "fontFamily",
                "$value": "{typography.family.sans}"
              },
              "fontSize": {
                "$type": "dimension",
                "$value": "{typography.size.lg}"
              },
              "fontWeight": {
                "$type": "fontWeight",
                "$value": 600
              },
              "lineHeight": {
                "$type": "number",
                "$value": 1.25
              },
              "letterSpacing": {
                "$type": "dimension",
                "$value": {
                  "value": 0,
                  "unit": "em"
                }
              }
            }
          }
        }
      ]
    }
  },
  "modifiers": {}
}
