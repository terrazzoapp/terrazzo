{
  "color": {
    "$type": "color",
    "brand": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0, 0.5],
        "alpha": 1
      }
    },
    "primary": {
      "$value": "{color.brand}"
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Helvetica"],
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    }
  }
}
